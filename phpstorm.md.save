<extensions defaultExtensionNs="com.intellij">
    <localInspection language="HTML" implementationClass="com.lucianpopescu.viewlanguage.TaglibMissingInspection"/>
</extensions>
 This tells PhpStorm: "This inspection runs on HTML files."

